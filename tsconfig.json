{
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2024"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noEmit": true,
		"skipLibCheck": true,
		"isolatedModules": true,
		"types": ["bun"]
	},
	"include": ["index.ts", "*.test.ts"],
	"exclude": ["node_modules"]
}
